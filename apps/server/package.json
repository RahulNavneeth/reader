{
  "name": "@reader/server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=${DATA_DIR:-../../data} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const{cpSync}=require('node:fs');cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@huggingface/transformers": "^3.0.2",
    "@napi-rs/canvas": "^1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "file-type": "^19.6.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.8.0",
    "minio": "^8.0.2",
    "nanoid": "^5.0.7",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^4.7.76",
    "pino-pretty": "^11.3.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
