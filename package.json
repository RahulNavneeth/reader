{
  "name": "reader",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w @reader/server run dev",
    "dev:web": "npm -w @reader/web run dev",
    "build": "npm -w @reader/server run build && npm -w @reader/web run build",
    "typecheck": "npm -w @reader/server run typecheck && npm -w @reader/web run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
