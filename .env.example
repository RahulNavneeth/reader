# Reader — environment configuration.
# Copy to .env and edit before `docker compose up`.

# ─────────────────────────────────────────────
# Required in production
# ─────────────────────────────────────────────

# Cookie-signing secret. >= 32 chars of randomness.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-please-32+

# MinIO root credentials (also used as S3 access/secret).
MINIO_ROOT_USER=readeradmin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-password

# ─────────────────────────────────────────────
# Optional — sensible defaults provided
# ─────────────────────────────────────────────

# HTTP server (host:port the app listens on inside the container).
SERVER_PORT=3001

# Cookie attributes
COOKIE_SECURE=false           # set to true behind HTTPS
COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30

# Allow new signups after the first user has been created.
# Default: false (admin generates invitations instead — admin UI roadmap).
ALLOW_OPEN_SIGNUP=false

# Maximum upload size in bytes (default 100 MB).
MAX_FILE_BYTES=104857600

# MinIO ports exposed on the host.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Ollama
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# S3 bucket. Created on first boot if missing.
S3_BUCKET=reader

# ─────────────────────────────────────────────
# Local-dev only (not used by docker-compose):
# ─────────────────────────────────────────────
# DATA_DIR=./data
# READER_ROOT=~/Documents
# STORAGE=local
