# Reader — environment configuration.
# Copy to .env and edit before `docker compose up`.

# ──────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────

# Cookie-signing secret. >= 32 chars of randomness.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-or-more

# ──────────────────────────────────────────────────────────────────
# Strongly recommended for any non-localhost deploy
# ──────────────────────────────────────────────────────────────────

# Public URL the app is served at (set when behind a reverse proxy).
# APP_URL=https://reader.example.com

# Cookie attributes. Set COOKIE_SECURE=true behind HTTPS.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# SESSION_TTL_DAYS=30

# Comma-separated CORS allowlist for production deployments.
# ALLOWED_ORIGINS=https://reader.example.com

# ──────────────────────────────────────────────────────────────────
# Optional — defaults below match docker-compose.yml
# ──────────────────────────────────────────────────────────────────

# Host port mapping (container always listens on 3001 internally).
# READER_PORT=3001

# Allow signups after the first user. First signup is always admin.
# ALLOW_OPEN_SIGNUP=false

# Max upload size in bytes (default 100 MB). Bump for video/archives.
# MAX_FILE_BYTES=536870912

# Ollama embedding model. Pull with:
#   docker compose exec ollama ollama pull <model>
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_ENABLED=true

# SMTP for outbound mail (share invites, etc.). Off by default;
# emails are logged to stdout when disabled.
# SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Reader <noreply@example.com>
# SMTP_SECURE=false
